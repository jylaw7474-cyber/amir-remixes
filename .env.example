# Supabase: Project Settings -> API (or Connect)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Mureka: platform.mureka.ai -> API Keys. Server-side only, never prefixed NEXT_PUBLIC_
MUREKA_API_KEY=

# Owner account the tracks belong to
ALLOWED_EMAILS=amir@jylaw.co.il

# The one password for signing in (pick your own)
APP_PASSWORD=

# Supabase: Project Settings -> API Keys -> Secret keys. Server-side only
SUPABASE_SECRET_KEY=
